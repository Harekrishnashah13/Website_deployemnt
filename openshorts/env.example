# Copied to app/.env by setup.sh. Keys can also be entered later in the
# dashboard under Settings.

# Google Gemini key (free tier works): https://aistudio.google.com/apikey
# Picks the viral moments from the transcript and drives the auto layout.
GEMINI_API_KEY=

# Whisper transcription. "small" is a good CPU default; "base" is faster.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Optional: run the moment picker on a local model instead of Gemini (Ollama).
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b

# Optional: YouTube cookies (Netscape format) if YouTube blocks downloads.
# YOUTUBE_COOKIES=

# Optional: S3 backup of generated clips.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-3
# AWS_S3_BUCKET=
