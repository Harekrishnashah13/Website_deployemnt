# Copy to .env and fill in. Never commit .env.

# Reddit (optional, recommended): create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=us-india-trade-sentiment/0.1 by u/your_username

# X / Twitter API v2 bearer token (Basic tier or higher is needed for search)
X_BEARER_TOKEN=

# Salt used to hash usernames so the dataset holds no raw handles
AUTHOR_HASH_SALT=change-me

# X via twscrape (no paid API): your X username and its browser cookies.
# Must include auth_token and ct0, e.g.  auth_token=abc123; ct0=def456
# Use a spare account: X may lock accounts used for scraping.
X_USERNAME=
X_COOKIES=
